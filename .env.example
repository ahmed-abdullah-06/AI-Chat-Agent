# Server port
PORT=3000

# Deployment environment: development | production | test
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API.
# Leave empty to allow any origin (convenient for local development).
CORS_ORIGIN=

# Trust proxy count (1 behind a single proxy such as nginx / Render / Railway).
TRUST_PROXY=1

# Rate limiting for /api/chat and /api/news
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# Upstream provider timeouts (ms)
UPSTREAM_TIMEOUT_MS=60000
FIRST_BYTE_TIMEOUT_MS=30000

# Request logging (true/false) and log level (debug|info|warn|error)
REQUEST_LOGS=true
LOG_LEVEL=info

# ------------------------------------------------------------------
# Server-side API keys (OPTIONAL).
# The frontend also lets each user paste their own key in Settings,
# which is stored in that browser's localStorage and sent per request
# via the x-api-key header. Server keys act as a shared fallback and
# keep keys out of client code entirely.
# ------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ------------------------------------------------------------------
# Local inference (OPTIONAL — this is the key-less mode).
# Any OpenAI-compatible server works: Ollama, LM Studio, llama.cpp, vLLM.
#
#   1. Install Ollama, then:      ollama serve
#   2. Pull a model, e.g.:        ollama pull llama3.2
#   3. In Settings pick "Local — Ollama (no API key)"
#
# No key is required. LOCAL_API_KEY is only for servers started with one
# (vllm serve --api-key ..., LM Studio's auth, a secured reverse proxy).
# ------------------------------------------------------------------
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=
